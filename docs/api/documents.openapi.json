  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "editor",
              "reader"
            ]
          },
          "employeeId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "profile",
          "employeeId",
          "name"
        ]
      },
      "IdentitySelection": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "editor",
              "reader"
            ]
          }
        },
        "required": [
          "profile"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "profile": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "employeeId",
          "profile",
          "csrfToken",
          "expiresAt"
        ]
      },
      "Permissions": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "requestId"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "version"
        ]
      },
      "Documents": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "requestId"
        ]
      },
      "DocumentUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "content",
          "version"
        ],
        "additionalProperties": false
      },
      "Saved": {
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "saved",
          "version",
          "requestId"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "securitySchemes": {
      "OfficeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "OFFICE_SESSION"
      }
    }
  }
}
