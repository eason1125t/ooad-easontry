{
  "openapi": "3.0.3",
  "info": {
    "title": "市政统一权限管理 API",
    "version": "0.1.0",
    "description": "RBAC0 本机实现。管理 API 除具体权限外还要求 platform:access；正式数据范围过滤不在本轮实现。"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本机开发"
    }
  ],
  "paths": {
    "/api/employees": {
      "get": {
        "operationId": "operation24",
        "summary": "分页读取脱敏员工关联选项",
        "tags": [
          "employees"
        ],
        "x-requirement-id": "FR-08",
        "x-required-permission": "employees:read",
        "x-implementation-status": "implemented; verification tracked in docs/测试与验收.md",
        "description": "管理操作还要求 platform:access。权限按服务端实时计算。",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePage"
                }
              }
            }
          },
          "400": {
            "description": "请求格式、字段或层级无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未认证、会话过期或账号不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无操作权限、CSRF 或来源校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "引用对象不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "唯一约束、版本冲突或最后管理员保护",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "登录尝试频率受限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "内部处理失败，不返回内部细节",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "description": "数字、#编号或员工 #编号为精确查询；其他文字仅匹配组织及合成姓名，不查询原始员工真实姓名或电话。"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "MUNI_SESSION"
      }
    },
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "description": "原始员工只返回员工 #ID，合成演示员工可返回合成名称"
          },
          "organizationName": {
            "type": "string"
          },
          "linkedAccountId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true,
            "description": "员工查询时返回已关联账号 ID；为空或省略表示未关联。身份接口可省略。"
          }
        },
        "required": [
          "id",
          "label",
          "organizationName"
        ]
      },
      "EmployeePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Employee"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "enum": [
              100
            ]
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
